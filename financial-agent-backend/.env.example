# Application
APP_NAME=AI Financial Agent
APP_VERSION=1.0.0
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://finagent:finagent_secret@db:5432/financial_agent
DATABASE_URL_SYNC=postgresql://finagent:finagent_secret@db:5432/financial_agent

# PostgreSQL (used by Docker Compose)
POSTGRES_USER=finagent
POSTGRES_PASSWORD=finagent_secret
POSTGRES_DB=financial_agent

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here

# Alpha Vantage (Market Data)
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key-here

# CORS
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# Server
HOST=0.0.0.0
PORT=8000
