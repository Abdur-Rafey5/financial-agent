# Application
APP_NAME=AI Financial Agent
APP_VERSION=1.0.0
DEBUG=true

# Database
# Local development defaults to SQLite. Set both URLs to PostgreSQL for
# production / Docker Compose.
DATABASE_URL=sqlite+aiosqlite:///./financial_agent.db
DATABASE_URL_SYNC=sqlite:///./financial_agent.db
# DATABASE_URL=postgresql+asyncpg://finagent:finagent_secret@db:5432/financial_agent
# DATABASE_URL_SYNC=postgresql://finagent:finagent_secret@db:5432/financial_agent

# PostgreSQL (used by Docker Compose)
POSTGRES_USER=finagent
POSTGRES_PASSWORD=finagent_secret
POSTGRES_DB=financial_agent

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API (leave empty for deterministic fallback answers)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

# Alpha Vantage (market data; leave empty to report quotes as unavailable)
ALPHA_VANTAGE_API_KEY=
# Optional: when no Alpha Vantage key is set, quote from Yahoo Finance
# (public keyless endpoints). Keep false for hermetic offline tests.
MARKET_KEYLESS_FALLBACK=false
MARKET_DATA_CACHE_TTL_SECONDS=900

# Seeding
SEED_DEFAULT_CATEGORIES=true
SEED_DEMO_DATA=false

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Server
HOST=0.0.0.0
PORT=8000
